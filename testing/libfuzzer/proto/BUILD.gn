import("//build/config/cronet/config.gni")
import("//third_party/protobuf/proto_library.gni")

proto_library("json_proto") {
  proto_in_dir = "//"
  sources = [ "json.proto" ]
}

proto_library("url_proto") {
  proto_in_dir = "//"
  sources = [ "url.proto" ]
}

source_set("url_proto_converter") {
  sources = [
    "url_proto_converter.cc",
    "url_proto_converter.h",
  ]
  deps = [
    ":url_proto",
    "//base",
  ]
}

if (!is_cronet_build) {
  source_set("json_proto_converter") {
    sources = [
      "json_proto_converter.cc",
      "json_proto_converter.h",
    ]
    deps = [ ":json_proto" ]
  }

  # PORT: dropped :skia_image_filter_converter and :skia_image_filter_proto.
  # They are the only thing in this file that needs //skia, and //net's fuzzer
  # targets make GN load this file even though no fuzzer is ever built here
  # (is_fuzzer_build is false). Vendoring //skia would also pull //gpu and
  # //ui.

  proto_library("string_compare_proto") {
    sources = [ "string_compare.proto" ]
  }
}
