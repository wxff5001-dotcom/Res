import("//build/config/chrome_build.gni")
import("//build/toolchain/win/midl.gni")

config("classic_com") {
  # This macro is used in <wrl/module.h>. Since only the COM functionality is
  # used here (while WinRT isn't being used), define this macro to optimize
  # compilation of <wrl/module.h> for COM-only.
  defines = [ "__WRL_CLASSIC_COM_STRICT__" ]
}

config("winver") {
  # <wrl/module.h> will try to use RuntimeObject.lib symbols when targeting
  # Windows 8.1 and up. Target Windows 8.0 to avoid this extra dependency.
  # Note that "//build/config/win:winver" must be removed from each target's
  # `configs` when adding this; even if this is added to a target's
  # `public_configs`.
  defines = [
    "NTDDI_VERSION=NTDDI_WIN8",

    # See //build/config/win/BUILD.gn for why not to use _WIN32_WINNT_WIN8.
    "_WIN32_WINNT=0x0602",
    "WINVER=0x0602",
  ]
}

# PORT: trimmed. Dropped :service_program_main (its only real content is
# Chrome product details and Event Log naming from //chrome/install_static),
# :crash_integration (needs //chrome/common:version_header and
# //components/crash/core/app), :test_service and the crashpad variants.
#
# :lib keeps the SCM handshake, which is the reusable part. Its
# //chrome/install_static dependency was stale -- service.cc,
# logging_support.cc and process_wrl_module.cc reference nothing from it.

source_set("constants") {
  public = [ "switches.h" ]
}

source_set("common") {
  public = [
    "get_calling_process.h",
    "scoped_client_impersonation.h",
  ]
  public_deps = [ "//base" ]
  sources = [
    "get_calling_process.cc",
    "scoped_client_impersonation.cc",
  ]
  libs = [ "rpcrt4.lib" ]
}

source_set("lib") {
  public = [
    "logging_support.h",
    "process_wrl_module.h",
    "service.h",
  ]
  public_deps = [ "//base" ]
  sources = [
    "logging_support.cc",
    "process_wrl_module.cc",
    "service.cc",
  ]
  configs -= [ "//build/config/win:winver" ]
  configs += [
    ":classic_com",
    ":winver",
  ]
  deps = [
    ":common",
    ":constants",
    ":delegate",
  ]
}

source_set("delegate") {
  public = [
    "factory_and_clsid.h",
    "service_delegate.h",
  ]
  public_deps = [ "//base" ]
  sources = [
    "factory_and_clsid.cc",
    "service_delegate.cc",
  ]
}
