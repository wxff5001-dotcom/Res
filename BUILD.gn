# Standalone Chromium-derived library targets.
group("default") {
  deps = [ ":libs" ]
}

group("libs") {
  deps = [
    "//base",
    "//chrome/chrome_elf:nt_registry",
    "//chrome/installer/util:constants",
    "//chrome/installer/util:metainstaller_utils",
    "//chrome/installer/util:work_item",
    "//components/crash/core/common",
    "//components/prefs",
    "//components/zucchini",
    "//mojo/core/embedder",
    "//mojo/public/cpp/bindings",
    "//mojo/public/cpp/platform",
    "//mojo/public/cpp/system",
    "//net",
    "//sql",
    "//third_party/crashpad/crashpad/client",
    "//third_party/lzma_sdk",
    "//url",
  ]
}

group("tests") {
  testonly = true
  deps = [
    "//base:base_unittests",
    "//mojo:mojo_unittests",
    "//rlz:rlz_machine_id_unittests",
  ]
  if (is_win) {
    deps += [
      "//sandbox/win:sbox_integration_tests",
      "//sandbox/win:sbox_unittests",
      "//sandbox/win:sbox_validation_tests",
    ]
  }
}
